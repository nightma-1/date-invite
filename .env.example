# Скопируй этот файл в .env и заполни своими данными.
# Если оставить пустым — сайт будет работать локально (через localStorage),
# но ответы не попадут в твою админку на другом устройстве.

# Данные проекта Supabase (Settings -> API в панели Supabase)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Пароль для входа в /admin (простая защита, см. README про её ограничения)
VITE_ADMIN_PASSWORD=change-me
